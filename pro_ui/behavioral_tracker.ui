  <property name="styleSheet">
   <string notr="true">
QWidget { font-family: "Segoe UI", "Inter", "Noto Sans", "Helvetica Neue", Arial, sans-serif; font-size: 10pt; color: #1f2a44; }
QMainWindow, QWidget#centralwidget { background: #f3f6fb; }
QStackedWidget &gt; QWidget { background: #f3f6fb; }
QToolTip { background: #1f2a44; color: #ffffff; border: none; padding: 4px 8px; }

/* sidebar + top bar */
QFrame#sidebar { background: #ffffff; border: none; border-right: 1px solid #e3e8f0; }
QFrame#sidebar QPushButton { text-align: left; padding: 10px 14px; border: none; border-radius: 8px; color: #334155; background: transparent; }
QFrame#sidebar QPushButton:hover:!checked { background: #eef3fb; }
QFrame#sidebar QPushButton:checked { background: #1f6feb; color: #ffffff; font-weight: 600; }
QLabel#logoLabel { background: transparent; border: none; }
QLabel#appTitle { font-size: 10pt; font-weight: 700; color: #1b2a4a; }
QLabel#appSubtitle { font-size: 7pt; color: #64748b; }
QFrame#topBar { background: #ffffff; border: none; border-bottom: 1px solid #e3e8f0; }
QLineEdit#searchEdit { border-radius: 16px; padding: 6px 14px; background: #f3f6fb; }

/* cards + text */
QFrame[cssClass="card"] { background: #ffffff; border: 1px solid #e3e8f0; border-radius: 10px; }
QLabel[cssClass="pageTitle"] { font-size: 18pt; font-weight: 700; color: #1b2a4a; }
QLabel[cssClass="pageSub"] { font-size: 10pt; color: #64748b; }
QLabel[cssClass="cardTitle"] { font-size: 11pt; font-weight: 700; color: #1b2a4a; }
QLabel[cssClass="fieldLabel"] { font-size: 9pt; color: #475569; }
QLabel[cssClass="muted"] { color: #64748b; }
QLabel[cssClass="statValue"] { font-size: 20pt; font-weight: 700; color: #1b2a4a; }
QLabel[cssClass="kpiValue"] { font-size: 15pt; font-weight: 700; color: #1b2a4a; }
QLabel[cssClass="videoSurface"] { background: #1c212b; color: #8b95a7; border-radius: 8px; font-size: 12pt; }
QLabel[cssClass="plotSurface"] { background: #ffffff; border: 1px dashed #c7d0de; border-radius: 6px; color: #94a3b8; }

/* buttons */
QPushButton[cssClass="primary"] { background: #1f6feb; color: #ffffff; border: none; border-radius: 6px; padding: 8px 16px; font-weight: 600; }
QPushButton[cssClass="primary"]:hover { background: #1a5fd0; }
QPushButton[cssClass="primary"]:pressed { background: #154eb0; }
QPushButton[cssClass="secondary"] { background: #ffffff; color: #1f2a44; border: 1px solid #d5dce8; border-radius: 6px; padding: 7px 14px; }
QPushButton[cssClass="secondary"]:hover { background: #f3f6fb; }
QPushButton[cssClass="danger"] { background: #ffffff; color: #d92d20; border: 1px solid #f0b4af; border-radius: 6px; padding: 7px 14px; }
QPushButton[cssClass="danger"]:hover { background: #fff5f4; }
QPushButton[cssClass="link"] { background: transparent; color: #1f6feb; border: none; padding: 2px 4px; }
QPushButton[cssClass="link"]:hover { text-decoration: underline; }
QPushButton[cssClass="segment"] { background: #ffffff; color: #1f2a44; border: 1px solid #d5dce8; border-radius: 6px; padding: 8px 12px; }
QPushButton[cssClass="segment"]:checked { background: #1f6feb; color: #ffffff; border-color: #1f6feb; font-weight: 600; }
QToolButton[cssClass="tile"] { background: #ffffff; border: 1px solid #e3e8f0; border-radius: 8px; padding: 6px; color: #334155; }
QToolButton[cssClass="tile"]:hover { background: #f6f9ff; }
QToolButton[cssClass="tile"]:checked { background: #eaf2ff; border: 1.5px solid #1f6feb; color: #1f6feb; }
QToolButton[cssClass="playBtn"] { background: #1f6feb; color: #ffffff; border: none; border-radius: 18px; font-size: 11pt; }
QToolButton[cssClass="stepBtn"] { background: #ffffff; border: 1px solid #d5dce8; border-radius: 6px; font-size: 12pt; color: #334155; }
QToolButton[cssClass="stepBtn"]:hover { background: #f3f6fb; }
QToolButton[cssClass="iconBtn"] { background: transparent; border: none; padding: 4px; color: #64748b; }
QToolButton[cssClass="iconBtn"]:hover { color: #1f6feb; }

/* inputs */
QLineEdit, QPlainTextEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox { background: #ffffff; border: 1px solid #d5dce8; border-radius: 6px; padding: 5px 8px; selection-background-color: #1f6feb; selection-color: #ffffff; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #1f6feb; }
QAbstractSpinBox QLineEdit { border: none; background: transparent; padding: 0; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #d5dce8; selection-background-color: #eaf2ff; selection-color: #1f2a44; outline: 0; }
QComboBox::drop-down, QDateEdit::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 26px; border: none; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(icons/chevron_down.svg); width: 12px; height: 12px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { width: 0px; border: none; }
QCheckBox { spacing: 8px; }
QSlider::groove:horizontal { height: 4px; background: #dbe3f0; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #1f6feb; border-radius: 2px; }
QSlider::handle:horizontal { background: #1f6feb; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; }
QProgressBar { background: #e6ecf5; border: none; border-radius: 4px; min-height: 8px; max-height: 8px; text-align: center; }
QProgressBar::chunk { background: #1f6feb; border-radius: 4px; }

/* tables */
QTableWidget { background: #ffffff; border: none; gridline-color: #eef2f8; selection-background-color: #eaf2ff; selection-color: #1f2a44; outline: 0; }
QTableWidget::item { padding: 4px 6px; border-bottom: 1px solid #eef2f8; }
QTableView QLineEdit { padding: 0px 4px; margin: 0px; border-radius: 0px; border: 1px solid #1f6feb; }
QTableView QAbstractSpinBox, QTableView QComboBox, QTableView QDateEdit { padding: 0px 4px; margin: 0px; border-radius: 0px; }
QTableView QAbstractSpinBox QLineEdit { border: none; padding: 0px; }
QHeaderView::section { background: #f7f9fc; color: #64748b; border: none; border-bottom: 1px solid #e3e8f0; padding: 8px 6px; font-weight: 600; }

/* tabs */
QTabWidget::pane { border: none; }
QTabWidget::tab-bar { alignment: left; }
QTabBar::tab { background: #ffffff; color: #475569; border: 1px solid #e3e8f0; border-radius: 6px; padding: 8px 22px; margin-right: 6px; min-width: 90px; }
QTabBar::tab:hover:!selected { background: #f6f9ff; }
QTabBar::tab:selected { background: #1f6feb; color: #ffffff; border-color: #1f6feb; font-weight: 600; }
</string>
